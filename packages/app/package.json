{
  "name": "@pixel/app",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "Electron editor for the dotloom-mcp pixel-art engine.",
  "author": "Lonely-bear",
  "license": "Apache-2.0",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-main.mjs && vite build",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "icon": "node scripts/make-icon.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pixel/core": "workspace:*",
    "@pixel/mcp": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "vite": "^8.3.0"
  }
}
