{
  "name": "@pixel/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Headless command line client for @pixel/core.",
  "bin": {
    "pixel": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
